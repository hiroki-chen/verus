#!/usr/bin/env bash

set -euo pipefail

VERSION="${1:-3.12.3}"
PREFIX="${2:-/opt/cpython-debug/${VERSION}}"
WORKDIR="${3:-/tmp/cpython-build-${VERSION}}"
ARCHIVE="Python-${VERSION}.tar.xz"
URL="https://www.python.org/ftp/python/${VERSION}/${ARCHIVE}"
SRCDIR="${WORKDIR}/Python-${VERSION}"

mkdir -p "${WORKDIR}" "${PREFIX}"
cd "${WORKDIR}"

if [[ ! -f "${ARCHIVE}" ]]; then
  curl -L -o "${ARCHIVE}" "${URL}"
fi

if [[ ! -d "${SRCDIR}" ]]; then
  tar xf "${ARCHIVE}"
fi

cd "${SRCDIR}"

./configure \
  --prefix="${PREFIX}" \
  --with-pydebug \
  --without-ensurepip \
  CFLAGS="-O0 -g" \
  LDFLAGS="-Wl,-no-as-needed"

make -j"$(nproc)"
make install

echo "built CPython ${VERSION} into ${PREFIX}"
echo "try:"
echo "  ${PREFIX}/bin/python3 -S -c 'print(\"hi\")'"
echo "  gdb --args ${PREFIX}/bin/python3 -S -c 'print(\"hi\")'"
